<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MedVoice | Patient Mode</title>
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-firestore.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: #000; color: white; margin: 0; text-align: center; }
        #waiting { height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; }
        #alert { display: none; height: 100vh; background: white; color: #000; padding: 20px; }
        #med-img { width: 100%; max-height: 60vh; border-radius: 25px; object-fit: contain; margin: 20px 0; }
        .btn-stop { background: #d63031; color: white; padding: 30px; border-radius: 20px; width: 100%; font-size: 2rem; border: none; font-weight: 900; }
    </style>
</head>
<body>

    <div id="waiting">
        <div style="font-size: 6rem; margin-bottom: 20px;">🎙️</div>
        <h1>MedVoice Active</h1>
        <p id="status-text">Tap the button below to start monitoring.</p>
        <button onclick="start()" id="start-btn" style="padding:20px 40px; border-radius:50px; border:none; background:#2a9d8f; color:white; font-weight:800; font-size: 1.2rem;">START MONITORING</button>
    </div>

    <div id="alert">
        <h1 style="font-size: 2.5rem; color: #d63031; margin: 0;">TIME FOR MEDICINE!</h1>
        <img id="med-img" src="">
        <h2 id="med-info" style="font-size: 1.5rem;"></h2>
        <button class="btn-stop" onclick="stopAlert()">I TOOK IT / تم الأخذ</button>
    </div>

<script>
    const firebaseConfig = {
        apiKey: "AIzaSyASth7cdm0Pr2wvORbyXwQ19LkSNoJMR0E",
        authDomain: "medvoice-8d2e0.firebaseapp.com",
        projectId: "medvoice-8d2e0",
        storageBucket: "medvoice-8d2e0.firebasestorage.app",
        messagingSenderId: "644370066289",
        appId: "1:644370066289:web:3f92c01653711151f4e4d0"
    };
    firebase.initializeApp(firebaseConfig);
    const db = firebase.firestore();

    let meds = [];
    let alertInterval;

    function start() {
        document.getElementById('start-btn').style.display = "none";
        document.getElementById('status-text').innerText = "Monitoring your schedule in real-time...";
        speak("System active. I will remind you when it is time.");

        // REAL-TIME SYNC
        db.collection("meds").onSnapshot((snapshot) => {
            meds = [];
            snapshot.forEach(doc => meds.push(doc.data()));
            console.log("Meds updated from cloud:", meds.length);
        });

        setInterval(checkTime, 10000);
    }

    function checkTime() {
        const now = new Date();
        const currentTime = now.getHours().toString().padStart(2, '0') + ":" + now.getMinutes().toString().padStart(2, '0');
        
        meds.forEach(m => {
            if(m.time === currentTime && !m.isAlerting) {
                m.isAlerting = true;
                triggerAlert(m);
            }
        });
    }

    function triggerAlert(m) {
        document.getElementById('alert').style.display = "block";
        document.getElementById('med-img').src = m.photo;
        document.getElementById('med-info').innerText = m.name + " - " + m.note;

        alertInterval = setInterval(() => {
            speak(`Attention. It is time for your ${m.name}. ${m.note}.`);
        }, 6000);
    }

    function stopAlert() {
        clearInterval(alertInterval);
        window.speechSynthesis.cancel();
        document.getElementById('alert').style.display = "none";
    }

    function speak(t) {
        const msg = new SpeechSynthesisUtterance(t);
        msg.rate = 0.7;
        window.speechSynthesis.speak(msg);
    }
</script>
</body>
</html>
